<?xml version="1.0"?>
<robot name="six_dof_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="base_height" value="0.05"/>
  <xacro:property name="link_radius" value="0.03"/>
  <xacro:property name="link1_len" value="0.10"/>
  <xacro:property name="link2_len" value="0.15"/>
  <xacro:property name="link3_len" value="0.15"/>
  <xacro:property name="link4_len" value="0.08"/>
  <xacro:property name="link5_len" value="0.06"/>
  <xacro:property name="link6_len" value="0.05"/>

  <material name="orange"><color rgba="1.0 0.5 0.0 1.0"/></material>
  <material name="grey"><color rgba="0.6 0.6 0.6 1.0"/></material>

  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.06" length="${base_height}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.06" length="${base_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <xacro:macro name="arm_link" params="name length radius:=${link_radius}">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${length/2}"/>
        <mass value="0.2"/>
        <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0002"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:arm_link name="link1" length="${link1_len}"/>
  <xacro:arm_link name="link2" length="${link2_len}"/>
  <xacro:arm_link name="link3" length="${link3_len}"/>
  <xacro:arm_link name="link4" length="${link4_len}" radius="0.02"/>
  <xacro:arm_link name="link5" length="${link5_len}" radius="0.02"/>
  <xacro:arm_link name="link6" length="${link6_len}" radius="0.015"/>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1.5"/>
  </joint>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 ${link1_len}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.5"/>
  </joint>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 ${link2_len}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.5"/>
  </joint>

  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 ${link3_len}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="5" velocity="2.0"/>
  </joint>

  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 ${link4_len}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="5" velocity="2.0"/>
  </joint>

  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 0 ${link5_len}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="5" velocity="2.0"/>
  </joint>

  <ros2_control name="ArmSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:macro name="joint_interface" params="joint_name">
      <joint name="${joint_name}">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:joint_interface joint_name="joint1"/>
    <xacro:joint_interface joint_name="joint2"/>
    <xacro:joint_interface joint_name="joint3"/>
    <xacro:joint_interface joint_name="joint4"/>
    <xacro:joint_interface joint_name="joint5"/>
    <xacro:joint_interface joint_name="joint6"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find arm_bringup)/config/arm_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>