<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_hardware_bridge</name>
  <version>0.0.0</version>
  <description>Real hardware bridge connecting MoveIt2 to ESP32 servo controller</description>
  <maintainer email="migara@todo.todo">migara</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>robot_state_publisher</depend>
  <depend>rviz2</depend>
  <depend>moveit_ros_move_group</depend>
  <depend>arm_description</depend>
  <depend>arm_moveit_config</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>